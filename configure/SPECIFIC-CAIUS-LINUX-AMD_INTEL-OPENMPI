#INFO#
#INFO# Configuration for Linux HPC cluster Equip@Meso / CPER AlsaCalcul /CPER GENI
#INFO# Intel Composer 2022 or later - OpenMPI + OMP 4.0 (or later)
#INFO# (IPCMS/Nagoya University, March 2026)
#INFO#
     IRAT=2
     FC='mpif90'
     CC='mpicc'
     LD='mpif90'
     CPP='/lib/cpp -P -traditional'
     CPPFLAGS='-D__HAS_FFT_DEFAULT -D__ALPHALINUX -D__AMD -D__HPC -D__HASNT_OMP_SET_NESTED \
         -D__PARALLEL -D__HAS_SIZEOF -D__HAS_BF_STREAM_IO -D__HASNT_MULTITHREAD_MPI_SUPPORT'
     CPPFLAGS_GROMOS='-DEWALD -DEWATCUT -DHAT_SHAPE -DUNPACKED_GRID \
              -D__HAS_FFT_DEFAULT -D__ALPHALINUX -D__AMD -D__HPC -D__HASNT_OMP_SET_NESTED \
             -D__PARALLEL -D__HAS_SIZEOF -D__HAS_BF_STREAM_IO -D__HASNT_MULTITHREAD_MPI_SUPPORT'
     FFLAGS_GROMOS='-fixed $(FFLAGS)'
     FFLAGS_GROMOS_MODULES=' $(FFLAGS)'
     AR='xiar -r'
     RANLIB='/usr/bin/ranlib'
     if [ $debug ]; then
       FFLAGS='-g'
       CFLAGS='-g -Wall -m64'
     else
       FFLAGS='-O2 -pc64 -funroll-loops -heap-arrays 64 -align array64byte -finline-functions -Wno-int-conversion'
       CFLAGS='-O2 -Wall -Wno-int-conversion '
     fi
     if [ $omp ]; then
       FFLAGS=${FFLAGS}' -qopenmp'
       OMP3_DISABLED='false'
       LIBS='-qmkl=parallel -lm'
     else
       LIBS='-static-intel -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core \
             -lm -lpthread -liomp5 '
     fi
     LFLAGS=${LIBS}
